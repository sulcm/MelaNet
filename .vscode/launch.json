    "version": "0.2.0",
    "configurations": [
        {
            "name": "Finetune - Image Classification",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/melanet/training/image_classification",
            "program": "run_image_classification.py",
            "console": "integratedTerminal",
            "args": [
                "--model_name_or_path", "/home/sulcm/models/melanet/google_hybrid_cnn_vit/base",
                // "--model_name_or_path", "timm/resnet50.a1_in1k",
                // "--ignore_mismatched_sizes", "True",
                "--dataset_name", "/home/sulcm/datasets/milk10k/SpilledMILK10k",
                "--image_column_name", "image",
                "--label_column_name", "label",
                "--remove_unused_columns", "False",
                "--output_dir", "/home/sulcm/models/melanet/debug/melanet_debug",
                "--overwrite_output_dir",
                "--max_steps", "100",
                "--learning_rate", "2e-5",
                "--per_device_train_batch_size", "8",
                "--per_device_eval_batch_size", "8",
                "--gradient_accumulation_steps", "1",
                "--logging_strategy", "steps",
                "--logging_steps", "10",
                "--eval_strategy", "steps",
                "--eval_steps", "10",
                "--save_strategy", "steps",
                "--save_steps", "50",
                "--save_total_limit", "3",
                "--load_best_model_at_end", "True",
                "--do_train",
                "--do_eval",
                "--fp16",
                // "--report_to", "wandb",
                "--report_to", "none",
                "--dataloader_num_workers", "4",
                "--seed", "42",
                "--max_eval_samples", "100",
                // "--loss_reduction", "mean",
                // "--ce_loss_multiplier", "0.5",
                // "--focal_loss_multiplier", "0.5",
                // "--hidden_dropout", "0.5",
                // "--attention_dropout", "0.5",
            ],
            "env": {
                "WANDB_PROJECT": "MelaNet-debug"
            },
            "justMyCode": false
        },
        {
            "name": "W&B - Sweep",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/melanet/training",
            "program": "run_sweep.py",
            "console": "integratedTerminal",
            "args": [
                "--sweep_config_path", "/home/sulcm/repos/MelaNet/melanet/training/image_classification/configs/resnet50/sweep_01.yaml",
                "--wandb_project", "Sweep-Debug",
                "--training_task", "image_classification",
                "--runs_count", "1",
            ],
            "justMyCode": false
        },
    ]
}